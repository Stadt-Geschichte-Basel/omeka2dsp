# DaSCH Service Platform Configuration
API_HOST="https://api.dasch.swiss"
INGEST_HOST="https://ingest.dasch.swiss"
PROJECT_SHORT_CODE="your_project_code"
DSP_USER="your_email@example.com"
DSP_PWD="your_password"

# Omeka Configuration
ITEM_SET_ID="10780"
OMEKA_API_URL="https://omeka.unibe.ch/api/"
KEY_IDENTITY=""
KEY_CREDENTIAL=""

# Ontology Configuration
ONTOLOGY_NAME="SGB"

# HTTP timeout in seconds for all requests
HTTP_TIMEOUT="30"

# HTTP timeout in seconds for file uploads to the ingest service
INGEST_TIMEOUT="600"

# Files above this size in bytes are not ingested.
# Sipi runs out of memory on very large files.
# MAX_INGEST_BYTES="500000000"

# Retries when DSP answers 429 Too Many Requests
DSP_RETRIES="20"
