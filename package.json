{
	"name": "omeka2dsp",
	"description": "Pipeline to ingest SGB Omeka S collection into DaSCH.",
	"author": "Stadt.Geschichte.Basel <info@stadtgeschichtebasel.ch>",
	"url": "https://github.com/Stadt-Geschichte-Basel/omeka2dsp/issues",
	"license": "AGPL-3.0",
	"scripts": {
		"check": "prettier --ignore-path .gitignore  --check . '!{CODE_OF_CONDUCT.md,LICENSE.md,LICENSE-CCBY.md,_layouts/default.html,package-lock.json,pnpm-lock.yaml,yarn.lock}'",
		"format": "prettier --ignore-path .gitignore --write . '!{CODE_OF_CONDUCT.md,LICENSE.md,LICENSE-CCBY.md,_layouts/default.html,package-lock.json,pnpm-lock.yaml,yarn.lock}'",
		"prepare": "husky",
		"changelog": "npm exec git-cliff -- --config cliff.toml"
	},
	"devDependencies": {
		"git-cliff": "^2.13.1",
		"husky": "^9.1.7",
		"prettier": "3.9.4"
	},
	"type": "module"
}
